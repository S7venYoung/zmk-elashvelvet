#define BASE 0
#define LOWER 1

#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

    };

    combos {
        compatible = "zmk,combos";

        flash {
            bindings = <&bootloader>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC    &kp N1        &kp N2            &kp N3        &kp N4  &kp N5                &kp NUMBER_6  &kp N7  &kp N8      &kp N9     &kp N0     &kp RIGHT_BRACKET
&kp TAB    &kp Q         &kp W             &kp E         &kp R   &kp T      &trans     &kp Y         &kp U   &kp I       &kp O      &kp P      &kp BACKSPACE
&kp LCMD   &kp A         &kp S             &kp D         &kp F   &kp G      &trans     &kp H         &kp J   &kp K       &kp L      &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z         &kp X             &kp C         &kp V   &kp B      &trans     &kp N         &kp M   &kp COMMA   &kp DOT    &kp SLASH  &kp RIGHT_SHIFT
           &kp CAPSLOCK  &kp LEFT_CONTROL  &kp LEFT_ALT  &mo 2   &kp SPACE             &kp SPACE     &mo 1   &kp DELETE  &kp MINUS  &kp EQUAL
            >;

            label = "BASE";
        };

        NVA {
            bindings = <
&kp GRAVE  &kp F1  &kp F2  &kp F3        &kp F4           &kp F5          &kp F6             &kp F7            &kp F8             &kp F9          &kp F10          &kp F11
&kp F11    &trans  &trans  &kp C_VOL_DN  &kp C_VOLUME_UP  &trans  &trans  &kp C_VOLUME_UP    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE
&kp F12    &kp N1  &kp N2  &kp N3        &kp N4           &kp N5  &trans  &kp C_VOLUME_DOWN  &kp PAGE_UP       &kp PAGE_DOWN      &kp HOME        &kp END          &kp INSERT
&trans     &trans  &trans  &trans        &trans           &trans  &trans  &kp C_MUTE         &trans            &trans             &trans          &trans           &trans
           &trans  &trans  &trans        &trans           &trans          &trans             &trans            &trans             &trans          &trans
            >;

        };

        SYS {
            bindings = <
&kp TILDE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &trans        &trans        &trans        &trans        &trans          &kp F12
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &kp UP_ARROW  &trans        &trans          &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans          &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
           &trans  &trans  &trans  &trans  &trans          &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL
            >;

        };
    };
};
