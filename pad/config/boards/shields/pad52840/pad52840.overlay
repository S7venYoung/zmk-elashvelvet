#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &pad_matrix;
        zmk,physical-layout = &pad_layout;
        zmk,underglow = &pad_rgb;
        zmk,ext-power = &pad_power;
    };

    pad_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Pad16";
        keys =
            <&key_physical_attrs 100 100 0 0 0 0 0>,
            <&key_physical_attrs 100 100 100 0 0 0 0>,
            <&key_physical_attrs 100 100 200 0 0 0 0>,
            <&key_physical_attrs 100 100 300 0 0 0 0>,
            <&key_physical_attrs 100 100 0 100 0 0 0>,
            <&key_physical_attrs 100 100 100 100 0 0 0>,
            <&key_physical_attrs 100 100 200 100 0 0 0>,
            <&key_physical_attrs 100 100 300 100 0 0 0>,
            <&key_physical_attrs 100 100 0 200 0 0 0>,
            <&key_physical_attrs 100 100 100 200 0 0 0>,
            <&key_physical_attrs 100 100 200 200 0 0 0>,
            <&key_physical_attrs 100 100 300 200 0 0 0>,
            <&key_physical_attrs 100 100 0 300 0 0 0>,
            <&key_physical_attrs 100 100 100 300 0 0 0>,
            <&key_physical_attrs 100 100 200 300 0 0 0>,
            <&key_physical_attrs 100 100 300 300 0 0 0>;
        kscan = <&pad_matrix>;
        transform = <&pad_transform>;
    };

    pad_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
        >;
    };

    pad_matrix: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>,
                    <&gpio0 22 GPIO_ACTIVE_HIGH>,
                    <&gpio0 24 GPIO_ACTIVE_HIGH>,
                    <&gpio1 0 GPIO_ACTIVE_HIGH>;
    };

    pad_power: ext_power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
    };
};

&spi1 { status = "disabled"; };
&spi3 { status = "okay"; compatible = "nordic,nrf-spim";
    pinctrl-0 = <&pad_rgb_default>;
    pinctrl-1 = <&pad_rgb_sleep>;
    pinctrl-names = "default", "sleep";
    pad_rgb: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <16>;
        color-mapping = <1 0 2>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
    };
};

&pinctrl {
    pad_rgb_default: pad_rgb_default {
        group1 { psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>; };
    };
    pad_rgb_sleep: pad_rgb_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>;
            low-power-enable;
        };
    };
};

/* Match the BL USER_FLASH_END and keep its power-cycle journal outside NVS. */
/* Rasi S140 7.3.0 reports SD_SIZE_GET = 0x27000. */
&code_partition { reg = <0x27000 0xc3000>; };
&flash0 {
    partitions {
        pad_replug_journal: partition@ea000 {
            label = "boot-power-journal";
            reg = <0xea000 0x1000>;
            read-only;
        };
    };
};

/* Match working Rasi BL defaults: neither DC/DC converter is enabled. */
&reg1 { regulator-initial-mode = <NRF5X_REG_MODE_LDO>; };
&reg0 { status = "disabled"; };
