#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS
                &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS
                &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER
                &mo 1     &kp KP_N0 &kp KP_DOT &kp BSPC
            >;
        };
        settings {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR
                &out OUT_USB &out OUT_BLE &rgb_ug RGB_TOG &rgb_ug RGB_EFF
                &rgb_ug RGB_BRI &rgb_ug RGB_BRD &sys_reset &bootloader
                &trans &kp KP_NUMLOCK &kp KP_DIVIDE &kp KP_MULTIPLY
            >;
        };
    };
};
